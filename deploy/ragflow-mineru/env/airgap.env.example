# Core RAGFlow settings. The Windows packaging script patches these values into
# the upstream RAGFlow docker/.env file before exporting the offline bundle.
DOC_ENGINE=infinity
DEVICE=gpu
COMPOSE_PROFILES=infinity,gpu,mineru,mineru-office,mineru-ui,md-convert,gateway
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4

# RAGFlow ports.
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382

# MinerU integration.
MINERU_IMAGE=mineru:latest
MINERU_GRADIO_IMAGE=mineru-gradio-offline:latest
MINERU_GRADIO_ROOT_PATH=/mineru-ui
MINERU_MODEL_SOURCE=local
MINERU_BACKEND=pipeline
MINERU_DELETE_OUTPUT=0
MINERU_ROUTER_PORT=8002
MINERU_GRADIO_PORT=7860
MINERU_LOCAL_GPUS=auto
MINERU_NVIDIA_VISIBLE_DEVICES=all
MINERU_CUDA_VISIBLE_DEVICES=0
MINERU_SHM_SIZE=32g

# Offline Office preprocessing for MinerU.
MINERU_OFFICE_GATEWAY_IMAGE=mineru-office-gateway:latest
MINERU_UPSTREAM_URL=http://mineru-router:8002
OFFICE_DEFAULT_MODE=pdf_ocr
OFFICE_PARSE_METHOD=ocr
OFFICE_BACKEND=pipeline
OFFICE_MAX_FILE_BYTES=104857600
OFFICE_MAX_FILES_PER_REQUEST=10
OFFICE_CONVERT_TIMEOUT_SECONDS=300
OFFICE_MAX_CONCURRENT_CONVERSIONS=1
OFFICE_TMP_DIR=/tmp/mineru-office
OFFICE_EXTRA_FONT_DIR=/opt/office-fonts
OFFICE_TMPFS_SIZE=1g
OFFICE_MEMORY_LIMIT=2g
OFFICE_CPU_LIMIT=2.0
OFFICE_PIDS_LIMIT=256

# Single public entry point. All browser/API access should go through this port.
PUBLIC_PORT=18080
RAGFLOW_WEB_UPSTREAM=ragflow-gpu:80
GATEWAY_MAX_BODY_SIZE=1024m
GATEWAY_PROXY_READ_TIMEOUT=3600s

# Markdown -> Word/PDF/HTML conversion service.
MD_CONVERT_IMAGE=md-convert:latest
GATEWAY_IMAGE=nginx:1.27-alpine
KROKI_IMAGE=yuzutech/kroki:latest
KROKI_MERMAID_IMAGE=yuzutech/kroki-mermaid:latest
MD_CONVERT_REDIS_DB=1
MD_CONVERT_QUEUE=md-convert
MD_CONVERT_MAX_UPLOAD_BYTES=52428800
MERMAID_OUTPUT_FORMAT=auto
MD_CONVERT_COOKIE_SECURE=false

# Production hardening. Change all upstream default passwords in docker/.env
# before packaging for a real deployment.
REGISTER_ENABLED=1
USE_DOCLING=false

# Replace these before production packaging. Keep values shell-safe: avoid
# spaces, quotes, and unescaped dollar signs.
ELASTIC_PASSWORD=change-me-elasticsearch
OPENSEARCH_PASSWORD=Change_me_OpenSearch_01
MYSQL_PASSWORD=change-me-mysql
MINIO_USER=rag_flow
MINIO_PASSWORD=change-me-minio
REDIS_PASSWORD=change-me-redis
OCEANBASE_PASSWORD=change-me-oceanbase
SEEKDB_PASSWORD=change-me-seekdb
