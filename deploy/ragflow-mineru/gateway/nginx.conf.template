map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    absolute_redirect off;
    client_max_body_size ${GATEWAY_MAX_BODY_SIZE};
    proxy_read_timeout ${GATEWAY_PROXY_READ_TIMEOUT};
    proxy_send_timeout ${GATEWAY_PROXY_READ_TIMEOUT};

    location = /convert {
        return 302 /convert/;
    }

    location /convert/ {
        proxy_pass http://md-convert-api:8080/;
        proxy_http_version 1.1;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location = /mineru {
        return 302 /mineru/;
    }

    location /mineru/ {
        proxy_pass http://mineru-office-gateway:8081/;
        proxy_http_version 1.1;
    }

    # Gradio 6.8 custom components can omit the deployment prefix.
    location ^~ /gradio_api/ {
        absolute_redirect off;
        add_header Cache-Control "no-store" always;
        return 307 /mineru-ui$request_uri;
    }

    location = /mineru-ui {
        return 302 /mineru-ui/;
    }

    location ^~ /mineru-ui/_offline/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        return 204;
    }

    location /mineru-ui/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        resolver_timeout 2s;
        set $mineru_gradio_upstream mineru-gradio:7860;
        rewrite ^/mineru-ui/(.*)$ /$1 break;
        proxy_pass http://$mineru_gradio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix /mineru-ui;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_intercept_errors on;
        error_page 502 504 =503 @mineru_ui_unavailable;
        sub_filter_types application/json application/javascript text/javascript text/css;
        sub_filter_once off;
        # Gradio prefixes relative stylesheet entries with its configured root.
        sub_filter 'https://fonts.googleapis.com' '_offline/google-fonts';
        sub_filter 'https://fonts.gstatic.com' '_offline/google-fonts-static';
        sub_filter 'https://cdnjs.cloudflare.com/ajax/libs/iframe-resizer/4.3.1/iframeResizer.contentWindow.min.js' '/mineru-ui/_offline/empty.js';
        sub_filter 'https://use.fontawesome.com/releases/v5.15.4/css/all.css' '/mineru-ui/_offline/empty.css';
        sub_filter 'https://img.shields.io/github/stars/opendatalab/MinerU.svg' 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self' data: blob:; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; frame-src 'self'; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:;" always;
    }

    location @mineru_ui_unavailable {
        default_type application/json;
        return 503 '{"detail":"MinerU Gradio UI is disabled or unavailable"}';
    }

    location / {
        proxy_pass http://${RAGFLOW_WEB_UPSTREAM};
        proxy_http_version 1.1;
    }
}
